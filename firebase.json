{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ]
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}